{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "../dist/mcp",
    "rootDir": "..",
    "sourceMap": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../lib/server/**/*.ts", "../lib/studio/**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../tests"]
}
